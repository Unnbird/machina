<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0</TargetFrameworks>
        <Configurations>Debug;Release;NuGet</Configurations>
    </PropertyGroup>
    
    <PropertyGroup>
        <Version>2.4.6.0</Version>
        <AssemblyVersion>2.4.6.0</AssemblyVersion>
        <FileVersion>2.4.6.0</FileVersion>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
    
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'NuGet|AnyCPU' ">
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>Ravahn.Machina.Keyfile.snk</AssemblyOriginatorKeyFile>
        <PackageId>Machina.FFXIV</PackageId>
        <DelaySign>false</DelaySign>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <Authors>Ravahn</Authors>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <RepositoryUrl>https://github.com/ravahn/machina</RepositoryUrl>
        <NeutralLanguage>en</NeutralLanguage>
        <Description>Extension to Machina network library to support decoding of Final Fantasy XIV network data</Description>
        <Copyright>Copyright © 2026 Ravahn</Copyright>
        <PackageProjectUrl>https://github.com/ravahn/machina</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='NuGet|netstandard2.0|AnyCPU'">
      <Optimize>True</Optimize>
    </PropertyGroup>
 
    <ItemGroup>
        <None Remove="Deucalion\Distrib\deucalion-1.2.1.dll" />
        <None Remove="Deucalion\Distrib\deucalion-1.5.0.dll" />
        <None Remove="Ravahn.Machina.Keyfile.snk" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Headers\Opcodes\Chinese.txt" />
        <EmbeddedResource Include="Headers\Opcodes\Global.txt" />
        <EmbeddedResource Include="Headers\Opcodes\TraditionalChinese.txt" />
        <EmbeddedResource Include="Headers\Opcodes\Korean.txt" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Headers\Opcodes\Chinese.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Opcodes\Chinese.txt</TargetPath>
            <Pack>True</Pack>
            <PackagePath>lib\$(TargetFrameworks)\Opcodes</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
        <Content Include="Headers\Opcodes\Global.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Opcodes\Global.txt</TargetPath>
            <Pack>True</Pack>
            <PackagePath>lib\$(TargetFrameworks)\Opcodes</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
        <Content Include="Headers\Opcodes\TraditionalChinese.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Opcodes\TraditionalChinese.txt</TargetPath>
            <Pack>True</Pack>
            <PackagePath>lib\$(TargetFrameworks)\Opcodes</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
        <Content Include="Headers\Opcodes\Korean.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Opcodes\Korean.txt</TargetPath>
            <Pack>True</Pack>
            <PackagePath>lib\$(TargetFrameworks)\Opcodes</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Machina\Machina.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\LICENSE.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>
  <ItemGroup>
      <Content Include="Deucalion\Distrib\deucalion-1.5.0.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <TargetPath>deucalion-1.5.0.dll</TargetPath>
          <Pack>True</Pack>
          <PackagePath>lib\$(TargetFrameworks)</PackagePath>
          <PackageCopyToOutput>true</PackageCopyToOutput>
      </Content>
      <Content Include="Deucalion\Distrib\deucalion-1.2.1.dll">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <TargetPath>deucalion-1.2.1.dll</TargetPath>
          <Pack>True</Pack>
          <PackagePath>lib\$(TargetFrameworks)</PackagePath>
          <PackageCopyToOutput>true</PackageCopyToOutput>
      </Content>
  </ItemGroup>
</Project>
